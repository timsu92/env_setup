# Example inventory for Proxmox push model.
# Copy this to pve_hosts.yml, fill in real IPs/hostnames, then use with:
#   ansible-playbook -i inventory/pve_hosts.yml playbooks/vm-pve.yml
all:
  children:
    vm:
      hosts:
        pve-vm-01:
          ansible_host: 192.168.1.10  # target host to setup
          ansible_user: tim  # user name used to ssh into
          # Optional: overlay netplan DNS/search on guests where cloud-init
          # delivers DNS metadata but the guest does not render search domains.
          # vm_pve_dns_servers:
          #   - 10.0.0.1
          # vm_pve_dns_search:
          #   - lan
          # WireGuard client config (used by wireguard_client role).
          # The role generates keys on the host and prints PublicKey + PresharedKey
          # at the end of the play — add them to the server's [Peer] block.
          wireguard_client_address: "192.168.100.2/24, fd73:9b2a:4c1e:2/112"
          wireguard_client_server_pubkey: "<server-public-key>"
          wireguard_client_endpoint: "..."
          # wireguard_client_allowedips: "..."  # optional, see role defaults
          # wireguard_client_dns: "1.1.1.1, 2606:4700:4700::1111"  # optional; unset/empty means no DNS line in wg0.conf
          # NFS mounts for this host (used by nfs_client role).
          # Remove or leave empty if no NFS mounts are needed.
          nfs_client_mounts:
            - src: "192.168.1.1:/mnt/shared_data"
              dest: /mnt/data
              opts: "defaults,nofail,_netdev,soft,timeo=30,retrans=5"
    lxc:
      hosts:
        pve-lxc-01:
          ansible_host: 192.168.1.20  # target host to setup
          # Pinned to root: Proxmox only ever provisions root on a fresh LXC
          # (WebUI SSH-pubkey/password fields both apply to it), and sshd's
          # PermitRootLogin prohibit-password keeps key-based root login
          # working indefinitely. setup_user (group_vars/lxc.yml) is the
          # separate, configured identity — see CLAUDE.md "Identity model".
          ansible_user: root  # user name used to ssh into
          nfs_client_mounts: []  # no NFS mounts for this LXC
