# Example inventory for Proxmox push model.
# Copy this to pve_hosts.yml, fill in real IPs/hostnames, then use with:
#   ansible-playbook -i inventory/pve_hosts.yml playbooks/vm-pve.yml
all:
  children:
    vm:
      hosts:
        pve-vm-01:
          ansible_host: 192.168.1.10  # target host to setup
          ansible_user: tim  # user name used to ssh into
          # WireGuard client config (used by wireguard_client role).
          # The role generates keys on the host and prints PublicKey + PresharedKey
          # at the end of the play — add them to the server's [Peer] block.
          wireguard_client_address: "192.168.100.2/24, fd73:9b2a:4c1e:2/112"
          wireguard_client_server_pubkey: "<server-public-key>"
          wireguard_client_endpoint: "..."
          # wireguard_client_allowedips: "..."  # optional, see role defaults
          # wireguard_client_dns: "1.1.1.1, 2606:4700:4700::1111"  # optional; unset/empty means no DNS line in wg0.conf
          # NFS mounts for this host (used by nfs_client role).
          # Remove or leave empty if no NFS mounts are needed.
          nfs_client_mounts:
            - src: "192.168.1.1:/mnt/shared_data"
              dest: /mnt/data
              opts: "defaults,nofail,_netdev,soft,timeo=30,retrans=5"
          # SonarQube user token (used by claude_code role); optional. When set, Ansible
          # writes it to ~/.config/zsh/non-interactive/15-sonarqube-cli.zsh; when unset,
          # an empty stub is deployed for you to fill in by hand. Must be a *user* token.
          # claude_code_sonarqube_token: "<user-token>"
          # SkillSpector LLM settings (used by skillspector role); optional. Without them the CLI and
          # its wrapper are still installed, but `skillspector scan` then needs --no-llm. When set,
          # Ansible writes them into the wrapper ~/.local/bin/skillspector (mode 0700), which exports
          # them only for the skillspector process, so they never reach the shell's environment.
          # Run `chmod 600` on this file once it holds a token.
          # skillspector_llm_base_url: "https://<host>/v1"  # up to /v1, not .../chat/completions
          # skillspector_llm_model: "<model-id>"
          # skillspector_llm_api_key: "<token>"
          # skillspector_llm_max_concurrency: 8  # stay within what the endpoint allows per user
          # skillspector_llm_reasoning_effort: low  # valid values depend on the endpoint
          # Token budget of a model SkillSpector does not know (it assumes 128000 / 32000 otherwise):
          # skillspector_llm_model_registry:
          #   context_length: 65536
          #   max_output_tokens: 16384
          # To use the local `claude` login instead (counts against the subscription quota, needs
          # no token or base URL; skillspector_llm_model is optional):
          # skillspector_llm_provider: claude_cli
    lxc:
      hosts:
        pve-lxc-01:
          ansible_host: 192.168.1.20  # target host to setup
          # Pinned to root: Proxmox only ever provisions root on a fresh LXC
          # (WebUI SSH-pubkey/password fields both apply to it), and sshd's
          # PermitRootLogin prohibit-password keeps key-based root login
          # working indefinitely. setup_user (group_vars/lxc.yml) is the
          # separate, configured identity — see CLAUDE.md "Identity model".
          ansible_user: root  # user name used to ssh into
          nfs_client_mounts: []  # no NFS mounts for this LXC
          # SonarQube user token (used by claude_code role); optional. When set, Ansible
          # writes it to ~/.config/zsh/non-interactive/15-sonarqube-cli.zsh; when unset,
          # an empty stub is deployed for you to fill in by hand. Must be a *user* token.
          # claude_code_sonarqube_token: "<user-token>"
          # SkillSpector LLM settings: same variables as for pve-vm-01 above (skillspector_llm_*).
          # skillspector_llm_base_url: "https://<host>/v1"
          # skillspector_llm_model: "<model-id>"
          # skillspector_llm_api_key: "<token>"
