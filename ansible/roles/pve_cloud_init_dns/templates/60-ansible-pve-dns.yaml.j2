network:
  version: 2
  ethernets:
    {{ pve_cloud_init_dns_override_effective_interface }}:
      # Some systemd-networkd builds (e.g., Debian trixie) default
      # DHCPv4 UseDomains to false, silently dropping the DHCP-provided
      # search domain.
      # Force it on so DHCP-supplied domains still merge with the static list.
      dhcp4-overrides:
        use-domains: true
      dhcp6-overrides:
        use-domains: true
