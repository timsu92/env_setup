# ~/.myzsh.zsh — personal zsh customizations, managed by Ansible (zsh role)

mkdir -p ~/.zfunc
fpath+=~/.zfunc

# Color support for ls/grep
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias ll='ls -alF --color=auto'
    alias la='ls -AF --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
else
    alias ll='ls -alF'
    alias la='ls -AF'
fi

# Override fg/bg builtins to support numeric and '-' arguments correctly
fg() {
    if [[ $# -eq 1 && $1 = - ]]; then
        builtin fg %-
    else
        builtin fg %"$@"
    fi
}

bg() {
    if [[ $# -eq 1 && $1 = - ]]; then
        builtin bg %-
    else
        builtin bg %"$@"
    fi
}

# Load zplug config if installed
[ -f ~/.myzsh_zplug.zsh ] && . ~/.myzsh_zplug.zsh
