#!/usr/bin/env bash
# bin/setup-container
# Provision this Docker container (local Ansible execution).
# Must be run INSIDE the container.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
export ANSIBLE_CONFIG="${REPO_ROOT}/ansible.cfg"

# shellcheck source=../utils/common.sh
source "${REPO_ROOT}/utils/common.sh"
# shellcheck source=../utils/locale.sh
source "${REPO_ROOT}/utils/locale.sh"

reexec_with_sudo "${BASH_SOURCE[0]}" "$@"

caller_ansible_vars
ensure_ansible

if ! ansible_locale="$(get_valid_utf8_locale)"; then
  echo "Error: No valid UTF-8 locale found. Please ensure a UTF-8 locale is generated and available in the container." >&2
  exit 1
fi

echo "==> Running container profile ..."
cd "${REPO_ROOT}/ansible"
LC_ALL="$ansible_locale" ansible-playbook -c local -i inventory/local.yml playbooks/container.yml "${CALLER_ANSIBLE_VARS[@]}" "$@"

echo "==> Done."
