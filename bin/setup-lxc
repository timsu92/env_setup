#!/usr/bin/env bash
# bin/setup-lxc
# Provision a Proxmox LXC container (push model from controller).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ANSIBLE_DIR="${REPO_ROOT}/ansible"
export ANSIBLE_CONFIG="${REPO_ROOT}/ansible.cfg"

# shellcheck source=../utils/common.sh
source "${REPO_ROOT}/utils/common.sh"

usage() {
  cat <<EOF
Usage: $0 --host <HOST>[,...] [OPTIONS]

Options:
  --host <HOST>[,...]  Target LXC(s) in ansible/inventory/pve_hosts.yml, comma-separated (required)
  --inventory <file>   Inventory file (default: inventory/pve_hosts.yml)
  -h, --help           Show this help

Any other option is passed to ansible-playbook as-is.

Examples:
  $0 --host pve-lxc-01
  $0 --host pve-lxc-01,pve-lxc-02
  $0 --host pve-lxc-01 --check --diff   # dry run
  $0 --host pve-lxc-01 -e var=value -vv
EOF
  exit 1
}

HOST=""
INVENTORY="inventory/pve_hosts.yml"
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)      HOST="$2"; shift 2 ;;
    --inventory) INVENTORY="$2"; shift 2 ;;
    -h|--help)   usage ;;
    *)           EXTRA_ARGS+=("$1"); shift ;;
  esac
done

[[ -z "$HOST" ]] && { echo "ERROR: --host is required"; usage; }

cd "${ANSIBLE_DIR}"
require_hosts_in_group "${INVENTORY}" lxc "${HOST}"
echo "==> Provisioning Proxmox LXC(s) at ${HOST} ..."
ansible-playbook -i "${INVENTORY}" -l "${HOST}" playbooks/lxc-pve.yml "${EXTRA_ARGS[@]}"
echo "==> Done."
