#!/usr/bin/env bash
# bin/setup-vm
# Provision a Proxmox VM (push model from controller) or WSL (local model).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ANSIBLE_DIR="${REPO_ROOT}/ansible"
export ANSIBLE_CONFIG="${REPO_ROOT}/ansible.cfg"
ORIGINAL_ARGS=("$@")

# shellcheck source=../utils/common.sh
source "${REPO_ROOT}/utils/common.sh"
# shellcheck source=../utils/locale.sh
source "${REPO_ROOT}/utils/locale.sh"

usage() {
  cat <<EOF
Usage: $0 [OPTIONS]

Options:
  --host <HOST>[,...]  Target VM(s) in ansible/inventory/pve_hosts.yml (comma-separated)
  --profile <name>     Profile to run: wsl | pve | pve-daily
  --inventory <file>   Inventory file (default: inventory/pve_hosts.yml)
  -h, --help           Show this help

Any other option is passed to ansible-playbook as-is.

Examples:
  $0                                       # provision local WSL machine
  $0 --host pve-vm-01                      # provision Proxmox VM (base profile)
  $0 --host pve-vm-01 --profile pve-daily  # provision Proxmox VM (daily-use profile)
  $0 --host pve-vm-01,pve-vm-02            # provision several Proxmox VMs in one run
  $0 --host pve-vm-01 --check --diff       # dry run
  $0 --host pve-vm-01 -e var=value -vv
EOF
  exit 1
}

PROFILE=""
HOST=""
INVENTORY="inventory/pve_hosts.yml"
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)      HOST="$2"; shift 2 ;;
    --profile)   PROFILE="$2"; shift 2 ;;
    --inventory) INVENTORY="$2"; shift 2 ;;
    -h|--help)   usage ;;
    *)           EXTRA_ARGS+=("$1"); shift ;;
  esac
done

if [[ -n "$HOST" && -z "$PROFILE" ]]; then
  PROFILE="pve"
elif [[ -z "$PROFILE" ]]; then
  PROFILE="wsl"
fi

cd "${ANSIBLE_DIR}"

case "$PROFILE" in
  wsl)
    # Exit if not running in WSL
    if [[ $(uname -r | tr '[:upper:]' '[:lower:]') != *"microsoft"* ]]; then
      echo -e "\033[31mERROR: WSL profile can only be run inside WSL\033[0m"
      usage
    fi

    # Before the sudo re-exec, so a new local.yml is owned by the invoking user.
    ensure_local_inventory "${REPO_ROOT}"

    reexec_with_sudo "${REPO_ROOT}/bin/setup-vm" "${ORIGINAL_ARGS[@]}"

    caller_ansible_vars

    if ! ansible_locale="$(get_valid_utf8_locale)"; then
      echo "Error: No valid UTF-8 locale found. Please ensure a UTF-8 locale is generated and available in WSL." >&2
      exit 1
    fi

    echo "==> Provisioning WSL daily driver (local) ..."
    ansible-playbook -c local -i inventory/local.yml playbooks/vm-daily-wsl.yml "${CALLER_ANSIBLE_VARS[@]}" -e "locale_term_env_lang=${ansible_locale}" "${EXTRA_ARGS[@]}"
    ;;
  pve)
    [[ -z "$HOST" ]] && { echo "ERROR: --host required for pve profile"; usage; }
    require_hosts_in_group "${INVENTORY}" vm "${HOST}"
    echo "==> Provisioning Proxmox VM(s) at ${HOST} (base profile) ..."
    ansible-playbook -i "${INVENTORY}" -l "${HOST}" playbooks/vm-pve.yml "${EXTRA_ARGS[@]}"
    ;;
  pve-daily)
    [[ -z "$HOST" ]] && { echo "ERROR: --host required for pve-daily profile"; usage; }
    require_hosts_in_group "${INVENTORY}" vm "${HOST}"
    echo "==> Provisioning Proxmox VM(s) at ${HOST} (daily-use profile) ..."
    ansible-playbook -i "${INVENTORY}" -l "${HOST}" playbooks/vm-daily-pve.yml "${EXTRA_ARGS[@]}"
    ;;
  *)
    echo "ERROR: unknown profile '${PROFILE}'"; usage ;;
esac

echo "==> Done."
