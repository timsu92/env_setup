#!/usr/bin/env bash
# bin/setup-vm
# Provision a Proxmox VM (push model from controller) or WSL (local model).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ANSIBLE_DIR="${REPO_ROOT}/ansible"
export ANSIBLE_CONFIG="${REPO_ROOT}/ansible.cfg"

usage() {
  cat <<EOF
Usage: $0 [OPTIONS]

Options:
  --host <HOST>        Target VM in ansible/inventory/pve_hosts.yml
  --profile <name>     Profile to run: wsl | pve | pve-daily
  --inventory <file>   Inventory file (default: inventory/pve_hosts.yml)
  -e <extra_vars>      Extra vars passed to ansible-playbook
  -h, --help           Show this help

Examples:
  $0                                       # provision local WSL machine
  $0 --host pve-vm-01                      # provision Proxmox VM (base profile)
  $0 --host pve-vm-01 --profile pve-daily  # provision Proxmox VM (daily-use profile)
EOF
  exit 1
}

PROFILE=""
HOST=""
INVENTORY="inventory/pve_hosts.yml"
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)      HOST="$2"; shift 2 ;;
    --profile)   PROFILE="$2"; shift 2 ;;
    --inventory) INVENTORY="$2"; shift 2 ;;
    -e)          EXTRA_ARGS+=(-e "$2"); shift 2 ;;
    -h|--help)   usage ;;
    *) echo "Unknown option: $1"; usage ;;
  esac
done

if [[ -n "$HOST" && -z "$PROFILE" ]]; then
  PROFILE="pve"
elif [[ -z "$PROFILE" ]]; then
  PROFILE="wsl"
fi

cd "${ANSIBLE_DIR}"

case "$PROFILE" in
  wsl)
    # Exit if not running in WSL
    if [[ $(uname -r | tr '[:upper:]' '[:lower:]') != *"microsoft"* ]]; then
      echo -e "\033[31mERROR: WSL profile can only be run inside WSL\033[0m"
      usage
    fi
    echo "==> Provisioning WSL daily driver (local) ..."
    ansible-playbook -c local -i -K inventory/local.yml playbooks/vm-daily-wsl.yml "${EXTRA_ARGS[@]}"
    ;;
  pve)
    [[ -z "$HOST" ]] && { echo "ERROR: --host required for pve profile"; usage; }
    echo "==> Provisioning Proxmox VM at ${HOST} (base profile) ..."
    ansible-playbook -i "${INVENTORY}" -l "${HOST}" playbooks/vm-pve.yml "${EXTRA_ARGS[@]}"
    ;;
  pve-daily)
    [[ -z "$HOST" ]] && { echo "ERROR: --host required for pve-daily profile"; usage; }
    echo "==> Provisioning Proxmox VM at ${HOST} (daily-use profile) ..."
    ansible-playbook -i "${INVENTORY}" -l "${HOST}" playbooks/vm-daily-pve.yml "${EXTRA_ARGS[@]}"
    ;;
  *)
    echo "ERROR: unknown profile '${PROFILE}'"; usage ;;
esac

echo "==> Done."
