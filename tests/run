#!/usr/bin/env bash
# Runs every tests/*.sh with bash and every tests/*.zsh with zsh, prints one
# verdict per file, exits non-zero if any file fails. Usage: bash tests/run
unset TMUX TMUX_PANE STY WINDOW CLAUDECODE
TESTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$TESTS_DIR/fakes:$PATH"
for c in tmux screen cswap; do
  p="$(command -v "$c")"
  [[ "$p" == "$TESTS_DIR"/fakes/* ]] || { echo "ISOLATION: '$c' resolves to '${p:-nothing}', not tests/fakes" >&2; exit 2; }
done

failed=0
shopt -s nullglob
for t in "$TESTS_DIR"/*.sh "$TESTS_DIR"/*.zsh; do
  case "$t" in *.zsh) runner=zsh ;; *) runner=bash ;; esac
  log="$(mktemp)"
  if "$runner" "$t" >"$log" 2>&1 && ! grep -q '^FAIL' "$log"; then
    echo "PASS ${t##*/} ($(grep -c '^PASS' "$log") rows)"
  else
    echo "FAIL ${t##*/}"
    grep -v '^PASS' "$log" | head -40 | sed 's/^/    /'
    failed=1
  fi
  rm -f "$log"
done
exit $failed
